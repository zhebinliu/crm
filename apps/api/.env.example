# ─── Attachment storage (Wave 18c) ──────────────────────────────────────
# "local"  → write to ./storage-data, served by /api/attachments/:id/download
# "s3"     → presigned PUT/GET against an S3 bucket (also works with MinIO)
STORAGE_BACKEND=local

# Used by both backends to mint presigned URLs that point back at the API.
PUBLIC_API_URL=http://localhost:3000

# Local-backend HMAC key. Falls back to JWT_SECRET if unset.
# LOCAL_STORAGE_SECRET=
# LOCAL_STORAGE_DIR=./storage-data

# S3 backend (only required when STORAGE_BACKEND=s3)
S3_REGION=us-east-1
S3_BUCKET=tokenwave-crm-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=  # optional; for MinIO (e.g. http://localhost:9000)
