// ────────────────────────────────────────────────────────────────────────────
// Tokenwave CRM — Prisma Schema
// Salesforce-style metadata-driven CRM with LTC (Lead-to-Cash) backbone,
// RBAC, configurable workflow engine, and approval processes.
// ────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════════════════
// TENANCY
// ════════════════════════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  plan      String   @default("standard")
  isActive  Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  roles               Role[]
  objects             ObjectDef[]
  fields              FieldDef[]
  picklists           Picklist[]
  workflowRules       WorkflowRule[]
  validationRules     ValidationRule[]
  approvalProcesses   ApprovalProcess[]
  leads               Lead[]
  accounts            Account[]
  contacts            Contact[]
  opportunities       Opportunity[]
  products            Product[]
  priceBooks          PriceBook[]
  quotes              Quote[]
  orders              Order[]
  contracts           Contract[]
  activities          Activity[]
  notes               Note[]
  attachments         Attachment[]
  auditLogs           AuditLog[]
  customRecords       CustomRecord[]
  emailTemplates      EmailTemplate[]
  priceRules          PriceRule[]
  forecastTargets     ForecastTarget[]
  forecastConfig      ForecastConfig?
  forecastUpdateTasks ForecastUpdateTask[]
  aiInsights          AIInsight[]
  notifications       Notification[]
  listViews           ListView[]
  recordShares        RecordShare[]
  cases               Case[]
  campaigns           Campaign[]
  campaignMembers     CampaignMember[]
  persons             Person[]
  recycleBinEntries   RecycleBinEntry[]
  recordEmbeddings    RecordEmbedding[]

  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────
// SEMANTIC SEARCH / RAG (Wave 17)
// ─────────────────────────────────────────────────────────────────────────
// Vector embeddings for tenant records, used for semantic retrieval to
// ground the AI Copilot on actual CRM data.
//
// Storage: pgvector is preferred but not available in the local Postgres,
// so we fall back to `Float[]` and compute cosine similarity in-process.
// To upgrade later: install the `vector` extension via
//   CREATE EXTENSION IF NOT EXISTS vector;
// then change `embedding Float[]` → `embedding Unsupported("vector(1536)")`
// and switch the search SQL to use the `<=>` operator.
//
// Dimension: 1536 (OpenAI text-embedding-3-small / ada-002 default).

model RecordEmbedding {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordType  String // "lead" | "contact" | "account" | "opportunity" | "case" | "activity"
  recordId    String

  // Vector embedding. Stored as Float[] (pgvector fallback).
  embedding   Float[]

  // Hash of the input text — used to skip re-embedding when content hasn't
  // changed (saves OpenAI tokens on every record save).
  contentHash String
  content     String   @db.Text

  model       String   @default("text-embedding-3-small")
  dimension   Int      @default(1536)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, recordType, recordId])
  @@index([tenantId, recordType])
  @@map("record_embeddings")
}

// ════════════════════════════════════════════════════════════════════════════
// AUTH + RBAC
// ════════════════════════════════════════════════════════════════════════════

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  displayName  String
  avatarUrl    String?
  phone        String?
  title        String? // job title
  department   String?
  managerId    String?
  manager      User?     @relation("UserManager", fields: [managerId], references: [id])
  subordinates User[]    @relation("UserManager")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  locale       String    @default("zh-CN")
  timezone     String    @default("Asia/Shanghai")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  roles                 UserRole[]
  sessions              Session[]
  refreshTokens         RefreshToken[]
  ownedLeads            Lead[]                @relation("LeadOwner")
  ownedAccounts         Account[]             @relation("AccountOwner")
  ownedContacts         Contact[]             @relation("ContactOwner")
  ownedOpps             Opportunity[]         @relation("OpportunityOwner")
  ownedQuotes           Quote[]               @relation("QuoteOwner")
  ownedOrders           Order[]               @relation("OrderOwner")
  ownedActivities       Activity[]            @relation("ActivityOwner")
  approvalActions       ApprovalAction[]
  ownedCustoms          CustomRecord[]        @relation("CustomRecordOwner")
  forecastTargets       ForecastTarget[]
  createdForecastTasks  ForecastUpdateTask[]  @relation("ForecastTaskCreator")
  forecastUpdateEntries ForecastUpdateEntry[] @relation("ForecastEntryUser")
  notifications         Notification[]
  listViews             ListView[]
  recordShares          RecordShare[]      @relation("RecordShareUser")
  ownedCases            Case[]             @relation("CaseOwner")
  ownedCampaigns        Campaign[]         @relation("CampaignOwner")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String // e.g. "admin", "sales_manager", "sales_rep"
  description String?
  isSystem    Boolean  @default(false)
  // Salesforce-style role hierarchy. A user with a parent role implicitly
  // sees records owned by users in any descendant role. Null = root role.
  parentId    String?
  parent      Role?    @relation("RoleParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Role[]   @relation("RoleParent")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("roles")
}

// ────────────────────────────────────────────────────────────────────────────
// RECORD-LEVEL SHARING
// Salesforce-style explicit shares. A row says: "User X (or Role Y, or
// Group G — only User in v1) has <accessLevel> on <recordType>:<recordId>".
// Combined with role hierarchy + ownerId, gives "who can see what".
// ────────────────────────────────────────────────────────────────────────────

enum ShareAccessLevel {
  READ
  EDIT
}

model RecordShare {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordType   String           // "lead" | "account" | "opportunity" | ...
  recordId     String
  // User this row grants access to
  userId       String
  user         User             @relation("RecordShareUser", fields: [userId], references: [id], onDelete: Cascade)
  accessLevel  ShareAccessLevel @default(READ)
  // "manual" | "rule:<ruleId>" | "team" — provenance of this share
  reason       String           @default("manual")
  createdAt    DateTime         @default(now())
  createdById  String?

  @@unique([tenantId, recordType, recordId, userId])
  @@index([tenantId, userId, recordType])
  @@index([tenantId, recordType, recordId])
  @@map("record_shares")
}

model Permission {
  id          String  @id @default(cuid())
  // scoped format: "<object>.<action>" e.g. "lead.read", "opportunity.write", "admin.*"
  code        String  @unique
  object      String // e.g. "lead", "admin", "workflow"
  action      String // e.g. "read", "write", "delete", "approve", "*"
  description String?

  roles RolePermission[]

  @@index([object])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ════════════════════════════════════════════════════════════════════════════
// METADATA (config-driven objects + fields)
// ════════════════════════════════════════════════════════════════════════════

enum FieldType {
  STRING
  TEXT // long text
  NUMBER
  DECIMAL
  CURRENCY
  BOOLEAN
  DATE
  DATETIME
  EMAIL
  PHONE
  URL
  PICKLIST
  MULTI_PICKLIST
  REFERENCE // FK to another object
  FORMULA
  JSON
}

model ObjectDef {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiName     String // e.g. "Lead", "Account", "custom_widget__c"
  label       String
  labelPlural String
  isSystem    Boolean  @default(false) // standard objects cannot be deleted
  isCustom    Boolean  @default(false)
  iconName    String?
  description String?
  layoutJson  Json? // page layout configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields FieldDef[]

  @@unique([tenantId, apiName])
  @@index([tenantId])
  @@map("object_defs")
}

model FieldDef {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objectId        String
  object          ObjectDef @relation(fields: [objectId], references: [id], onDelete: Cascade)
  apiName         String // e.g. "amount", "custom_score__c"
  label           String
  type            FieldType
  required        Boolean   @default(false)
  unique          Boolean   @default(false)
  isStandard      Boolean   @default(false)
  isCustom        Boolean   @default(false)
  defaultValue    Json?
  helpText        String?
  picklistId      String?
  picklist        Picklist? @relation(fields: [picklistId], references: [id])
  referenceTo     String? // object apiName when type=REFERENCE
  formulaExpr     String? // expression when type=FORMULA
  validationRegex String?
  minValue        Decimal?  @db.Decimal(20, 6)
  maxValue        Decimal?  @db.Decimal(20, 6)
  precision       Int?
  scale           Int?
  readPermission  String? // permission code required to read
  writePermission String?
  displayOrder    Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([objectId, apiName])
  @@index([tenantId])
  @@map("field_defs")
}

model Picklist {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiName     String // e.g. "lead_status", "industry"
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values PicklistValue[]
  fields FieldDef[]

  @@unique([tenantId, apiName])
  @@index([tenantId])
  @@map("picklists")
}

model PicklistValue {
  id           String   @id @default(cuid())
  picklistId   String
  picklist     Picklist @relation(fields: [picklistId], references: [id], onDelete: Cascade)
  value        String
  label        String
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  color        String? // UI hint
  metadata     Json     @default("{}")

  @@unique([picklistId, value])
  @@map("picklist_values")
}

// ════════════════════════════════════════════════════════════════════════════
// LTC CORE — Lead to Cash
// ════════════════════════════════════════════════════════════════════════════

model Lead {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId  String
  owner    User   @relation("LeadOwner", fields: [ownerId], references: [id])

  // Customer 360: link to the canonical Person identity (set on create/update
  // by IdentityResolutionService). Optional because IdentityRule may surface
  // a match for human confirmation rather than auto-link.
  personId String?
  person   Person? @relation("LeadPerson", fields: [personId], references: [id], onDelete: SetNull)

  // identity
  firstName String?
  lastName  String
  company   String
  title     String?
  email     String?
  phone     String?
  mobile    String?
  website   String?

  // qualification
  status        String   @default("new") // picklist: new/working/nurturing/qualified/unqualified
  rating        String? // hot/warm/cold
  source        String? // picklist
  industry      String?
  annualRevenue Decimal? @db.Decimal(18, 2)
  employeeCount Int?
  score         Int? // lead score 0-100

  // address
  street     String?
  city       String?
  state      String?
  postalCode String?
  country    String?

  description  String? @db.Text
  customFields Json    @default("{}")

  // conversion
  isConverted        Boolean   @default(false)
  convertedAt        DateTime?
  convertedAccountId String?
  convertedContactId String?
  convertedOppId     String?

  campaignMembers    CampaignMember[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([tenantId, email])
  @@index([tenantId, isConverted])
  @@index([tenantId, personId])
  @@map("leads")
}

model Account {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId  String
  owner    User      @relation("AccountOwner", fields: [ownerId], references: [id])
  parentId String?
  parent   Account?  @relation("AccountParent", fields: [parentId], references: [id])
  children Account[] @relation("AccountParent")

  name          String
  type          String? // picklist: customer/prospect/partner/competitor
  industry      String?
  website       String?
  phone         String?
  annualRevenue Decimal? @db.Decimal(18, 2)
  employeeCount Int?
  rating        String?
  description   String?  @db.Text

  billingStreet      String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  customFields Json @default("{}")

  contacts      Contact[]
  opportunities Opportunity[]
  quotes        Quote[]
  orders        Order[]
  contracts     Contract[]
  cases         Case[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([tenantId, ownerId])
  @@index([tenantId, name])
  @@map("accounts")
}

model Contact {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User      @relation("ContactOwner", fields: [ownerId], references: [id])
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  reportsToId String?
  reportsTo   Contact?  @relation("ContactReports", fields: [reportsToId], references: [id])
  reports     Contact[] @relation("ContactReports")

  // Customer 360: link to the canonical Person identity (see Lead.personId).
  personId String?
  person   Person? @relation("ContactPerson", fields: [personId], references: [id], onDelete: SetNull)

  firstName    String?
  lastName     String
  title        String?
  department   String?
  email        String?
  phone        String?
  mobile       String?
  fax          String?
  birthday     DateTime?
  description  String?   @db.Text
  customFields Json      @default("{}")

  mailingStreet     String?
  mailingCity       String?
  mailingState      String?
  mailingPostalCode String?
  mailingCountry    String?

  cases             Case[]
  campaignMembers   CampaignMember[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([tenantId, accountId])
  @@index([tenantId, email])
  @@index([tenantId, personId])
  @@map("contacts")
}

model Opportunity {
  id               String  @id @default(cuid())
  tenantId         String
  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User    @relation("OpportunityOwner", fields: [ownerId], references: [id])
  accountId        String
  account          Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  primaryContactId String?

  name             String
  stage            String   @default("prospecting") // picklist
  amount           Decimal? @db.Decimal(18, 2)
  currencyCode     String   @default("CNY")
  probability      Int      @default(10) // 0-100
  forecastCategory String   @default("pipeline") // pipeline/best_case/commit/closed
  closeDate        DateTime
  type             String? // new_business/existing_business/renewal
  leadSource       String?
  nextStep         String?
  description      String?  @db.Text
  lossReason       String?

  isClosed     Boolean @default(false)
  isWon        Boolean @default(false)
  customFields Json    @default("{}")

  lineItems OpportunityLineItem[]
  quotes    Quote[]
  orders    Order[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([tenantId, stage])
  @@index([tenantId, ownerId])
  @@index([tenantId, accountId])
  @@index([tenantId, closeDate])
  @@map("opportunities")
}

model ForecastTarget {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    String // "2026-Q2"
  quota     Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, period])
  @@index([tenantId, period])
  @@map("forecast_targets")
}

model ForecastConfig {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // F2: stage→category mapping JSON { "prospecting": "pipeline", ... }
  categories    Json     @default("{}")
  // F3: custom object for forecast data source
  objectApiName String   @default("opportunity")
  amountField   String   @default("amount")
  dateField     String   @default("closeDate")
  stageField    String   @default("stage")
  ownerField    String   @default("ownerId")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("forecast_configs")
}

model ForecastUpdateTask {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User     @relation("ForecastTaskCreator", fields: [createdById], references: [id])
  period        String // "2026-Q2"
  title         String
  dueDate       DateTime
  targetUserIds Json     @default("[]") // string[]
  dateRangeFrom DateTime
  dateRangeTo   DateTime
  status        String   @default("open") // open | closed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries ForecastUpdateEntry[]

  @@index([tenantId, period])
  @@index([tenantId, status])
  @@map("forecast_update_tasks")
}

model ForecastUpdateEntry {
  id            String             @id @default(cuid())
  taskId        String
  task          ForecastUpdateTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation("ForecastEntryUser", fields: [userId], references: [id])
  oppId         String
  oppName       String
  prevAmount    Decimal?           @db.Decimal(18, 2)
  prevCloseDate DateTime?
  newAmount     Decimal?           @db.Decimal(18, 2)
  newCloseDate  DateTime?
  noChange      Boolean            @default(false)
  submittedAt   DateTime?

  @@unique([taskId, userId, oppId])
  @@index([taskId, userId])
  @@map("forecast_update_entries")
}

model Product {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String // SKU
  name         String
  family       String?
  description  String? @db.Text
  isActive     Boolean @default(true)
  unit         String  @default("unit")
  taxable      Boolean @default(true)
  customFields Json    @default("{}")

  priceEntries   PriceBookEntry[]
  oppLineItems   OpportunityLineItem[]
  quoteLineItems QuoteLineItem[]
  orderLineItems OrderLineItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("products")
}

model PriceBook {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isStandard  Boolean   @default(false) // exactly one per tenant
  isActive    Boolean   @default(true)
  validFrom   DateTime?
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries PriceBookEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("price_books")
}

model PriceBookEntry {
  id           String    @id @default(cuid())
  priceBookId  String
  priceBook    PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice    Decimal   @db.Decimal(18, 4)
  currencyCode String    @default("CNY")
  isActive     Boolean   @default(true)

  @@unique([priceBookId, productId, currencyCode])
  @@map("price_book_entries")
}

model OpportunityLineItem {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Decimal     @db.Decimal(18, 4)
  unitPrice     Decimal     @db.Decimal(18, 4)
  discount      Decimal     @default(0) @db.Decimal(5, 2) // percent
  subtotal      Decimal     @db.Decimal(18, 2)
  description   String?
  sortOrder     Int         @default(0)

  @@index([opportunityId])
  @@map("opportunity_line_items")
}

model Quote {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User         @relation("QuoteOwner", fields: [ownerId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id])

  quoteNumber  String // e.g. Q-2026-00001
  name         String
  status       String    @default("draft") // draft/in_review/approved/presented/accepted/rejected/expired
  currencyCode String    @default("CNY")
  expiresAt    DateTime?

  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  shippingAmount Decimal @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal @default(0) @db.Decimal(18, 2)

  billingStreet      String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  notes              String? @db.Text
  termsAndConditions String? @db.Text
  customFields       Json    @default("{}")

  lineItems QuoteLineItem[]
  orders    Order[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, status])
  @@index([tenantId, opportunityId])
  @@map("quotes")
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(18, 2)
  description String?
  sortOrder   Int     @default(0)

  @@index([quoteId])
  @@map("quote_line_items")
}

model Order {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User         @relation("OrderOwner", fields: [ownerId], references: [id])
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  quoteId       String?
  quote         Quote?       @relation(fields: [quoteId], references: [id])
  contractId    String?
  contract      Contract?    @relation(fields: [contractId], references: [id])

  orderNumber   String
  status        String    @default("draft") // draft/activated/shipped/delivered/cancelled
  type          String? // new/renewal/upgrade
  effectiveDate DateTime
  endDate       DateTime?
  poNumber      String? // customer PO
  currencyCode  String    @default("CNY")

  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  shippingAmount Decimal @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal @default(0) @db.Decimal(18, 2)

  billingStreet      String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  notes        String? @db.Text
  customFields Json    @default("{}")

  lineItems OrderLineItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, accountId])
  @@map("orders")
}

model OrderLineItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(18, 2)
  description String?
  sortOrder   Int     @default(0)

  @@index([orderId])
  @@map("order_line_items")
}

model Contract {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id])
  contractNumber   String
  name             String
  status           String    @default("draft") // draft/in_approval/activated/expired/terminated
  startDate        DateTime
  endDate          DateTime
  term             Int? // months
  contractValue    Decimal?  @db.Decimal(18, 2)
  currencyCode     String    @default("CNY")
  billingFrequency String? // monthly/quarterly/annual/one_time
  paymentTerms     String? // net_30 etc
  description      String?   @db.Text
  signedAt         DateTime?
  signedBy         String?
  customFields     Json      @default("{}")

  orders Order[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([tenantId, contractNumber])
  @@index([tenantId, status])
  @@map("contracts")
}

// ════════════════════════════════════════════════════════════════════════════
// ACTIVITY (Task/Event/Call/Email) — polymorphic to any record
// ════════════════════════════════════════════════════════════════════════════

enum ActivityType {
  TASK
  EVENT
  CALL
  EMAIL
  MEETING
  NOTE_LOG
}

enum ActivityStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DEFERRED
  CANCELLED
}

model Activity {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId  String
  owner    User   @relation("ActivityOwner", fields: [ownerId], references: [id])

  type        ActivityType
  subject     String
  status      ActivityStatus @default(OPEN)
  priority    String         @default("normal") // low/normal/high
  dueDate     DateTime?
  startAt     DateTime?
  endAt       DateTime?
  location    String?
  description String?        @db.Text

  // polymorphic target
  targetType String? // "lead" | "account" | "contact" | "opportunity" | ...
  targetId   String?

  completedAt  DateTime?
  customFields Json      @default("{}")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([tenantId, ownerId, status])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, dueDate])
  @@map("activities")
}

model Note {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId   String
  title      String?
  body       String   @db.Text
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, targetType, targetId])
  @@map("notes")
}

model Attachment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploaderId  String
  filename    String
  contentType String
  size        Int
  url         String
  targetType  String
  targetId    String
  createdAt   DateTime @default(now())

  @@index([tenantId, targetType, targetId])
  @@map("attachments")
}

// ════════════════════════════════════════════════════════════════════════════
// SERVICE CLOUD — CASES
// Customer support tickets. Polymorphic-targetable (can hang off an Account
// or Contact). Status moves new → working → escalated → closed. Priority
// drives queue triage. Source tracks origin (email/phone/portal/api).
// ════════════════════════════════════════════════════════════════════════════

enum CaseStatus {
  NEW
  WORKING
  ESCALATED
  WAITING_ON_CUSTOMER
  CLOSED_RESOLVED
  CLOSED_NOT_RESOLVED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Case {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseNumber   String       // human-readable (e.g. "CASE-0042")
  subject      String
  description  String?      @db.Text
  status       CaseStatus   @default(NEW)
  priority     CasePriority @default(NORMAL)
  // origin: "email" | "phone" | "web" | "portal" | "api" | "chat"
  source       String       @default("web")
  // SLA fields (could be enriched from a future SLA policy table).
  slaTargetAt  DateTime?
  firstResponseAt DateTime?
  resolvedAt   DateTime?

  ownerId      String
  owner        User         @relation("CaseOwner", fields: [ownerId], references: [id])
  // Polymorphic-ish relations to standard CRM objects
  accountId    String?
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId    String?
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  customFields Json         @default("{}")

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  comments     CaseComment[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([tenantId, accountId])
  @@index([tenantId, priority, status])
  @@map("cases")
}

model CaseComment {
  id         String   @id @default(cuid())
  tenantId   String
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId   String
  body       String   @db.Text
  // Internal notes are visible to staff only; public comments may surface
  // to the customer portal.
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId, caseId])
  @@map("case_comments")
}

// ════════════════════════════════════════════════════════════════════════════
// MARKETING CLOUD — CAMPAIGNS
// A campaign is a marketing activity (event, email blast, ad). Members are
// Leads/Contacts engaged with it. status tracks their journey (sent → opened
// → responded → converted).
// ════════════════════════════════════════════════════════════════════════════

enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ABORTED
}

enum CampaignType {
  EMAIL
  EVENT
  WEBINAR
  AD
  REFERRAL
  CONTENT
  OTHER
}

model Campaign {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User             @relation("CampaignOwner", fields: [ownerId], references: [id])

  name            String
  type            CampaignType     @default(EMAIL)
  status          CampaignStatus   @default(PLANNED)
  startDate       DateTime?
  endDate         DateTime?
  // Budget tracking
  budgetedCost    Decimal?         @db.Decimal(18, 2)
  actualCost      Decimal?         @db.Decimal(18, 2)
  expectedRevenue Decimal?         @db.Decimal(18, 2)
  // Aggregates auto-recalculated from CampaignMember
  numSent         Int              @default(0)
  numResponses    Int              @default(0)
  numConverted    Int              @default(0)
  description     String?          @db.Text
  customFields    Json             @default("{}")

  members         CampaignMember[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@map("campaigns")
}

enum CampaignMemberStatus {
  SENT
  RECEIVED
  OPENED
  CLICKED
  RESPONDED
  CONVERTED
  UNSUBSCRIBED
  BOUNCED
}

model CampaignMember {
  id           String                @id @default(cuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Either a Lead or a Contact (one must be set). Standard SF-style attribution.
  leadId       String?
  lead         Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status       CampaignMemberStatus  @default(SENT)
  respondedAt  DateTime?

  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([tenantId, campaignId, leadId, contactId])
  @@index([tenantId, campaignId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@map("campaign_members")
}

// ════════════════════════════════════════════════════════════════════════════
// EMAIL TEMPLATES
// ════════════════════════════════════════════════════════════════════════════

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  body      String   @db.Text
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("email_templates")
}

// ════════════════════════════════════════════════════════════════════════════
// PRICE RULES
// ════════════════════════════════════════════════════════════════════════════

model PriceRule {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  objectType        String   @default("Quote") // Quote or Opportunity
  discountThreshold Decimal  @db.Decimal(5, 2) // percent, e.g. 10.00 means >10% triggers
  approvalProcessId String? // linked approval process
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("price_rules")
}

// ════════════════════════════════════════════════════════════════════════════
// WORKFLOW ENGINE
// ════════════════════════════════════════════════════════════════════════════

enum WorkflowTrigger {
  ON_CREATE
  ON_UPDATE
  ON_FIELD_CHANGE
  ON_DELETE
  SCHEDULED
  MANUAL
}

enum WorkflowStatus {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

model WorkflowRule {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  objectApiName String // e.g. "lead", "opportunity"
  trigger       WorkflowTrigger
  // for ON_FIELD_CHANGE: array of field api names
  watchFields   String[]        @default([])
  // JSON rule tree (see rule-engine package): { all: [...] } or { any: [...] }
  conditions    Json            @default("{}")
  // Array of action descriptors: { type, params }
  actions       Json            @default("[]")
  // for SCHEDULED: cron expression
  cronExpr      String?
  // run sync (in transaction) vs async (queued)
  runSync       Boolean         @default(false)
  priority      Int             @default(100) // lower runs first
  isActive      Boolean         @default(true)
  // re-entrancy guard
  runOnceFlag   Boolean         @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  executions WorkflowExecution[]

  @@index([tenantId, objectApiName, isActive])
  @@map("workflow_rules")
}

model WorkflowExecution {
  id               String          @id @default(cuid())
  ruleId           String
  rule             WorkflowRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tenantId         String
  recordType       String
  recordId         String
  trigger          WorkflowTrigger
  status           WorkflowStatus
  conditionsResult Boolean         @default(false)
  actionsLog       Json            @default("[]")
  error            String?         @db.Text
  durationMs       Int?
  startedAt        DateTime        @default(now())
  finishedAt       DateTime?

  @@index([tenantId, recordType, recordId])
  @@index([ruleId, startedAt])
  @@map("workflow_executions")
}

model ValidationRule {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  objectApiName String
  // Rule that when evaluates TRUE, the save is BLOCKED (Salesforce semantics).
  conditions    Json    @default("{}")
  errorMessage  String
  errorField    String? // optional field to attach the error to
  isActive      Boolean @default(true)
  priority      Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, objectApiName, isActive])
  @@map("validation_rules")
}

// ════════════════════════════════════════════════════════════════════════════
// APPROVAL PROCESSES
// ════════════════════════════════════════════════════════════════════════════

enum ApproverSource {
  USER // fixed user id
  ROLE // any user with role code
  MANAGER // submitter's manager chain
  FIELD // user id from a field on the record (e.g. account.ownerId.manager)
  DYNAMIC // resolved via rule/formula
}

enum ApprovalStepMode {
  SEQUENTIAL // one approver at a time; all must approve
  PARALLEL_ALL // everyone in parallel; all must approve
  PARALLEL_ANY // anyone can approve to advance
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RECALLED
}

enum ApprovalActionType {
  SUBMIT
  APPROVE
  REJECT
  REASSIGN
  RECALL
  COMMENT
}

model ApprovalProcess {
  id                  String  @id @default(cuid())
  tenantId            String
  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  objectApiName       String
  // Records matching entry criteria can be submitted for approval.
  entryCriteria       Json    @default("{}")
  // When approved, what to do (field updates etc). Same action schema as workflow.
  finalApproveActions Json    @default("[]")
  finalRejectActions  Json    @default("[]")
  // On submit: lock the record? (blocks edits)
  lockOnSubmit        Boolean @default(true)
  isActive            Boolean @default(true)
  priority            Int     @default(100)
  version             Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps    ApprovalStep[]
  requests ApprovalRequest[]

  @@index([tenantId, objectApiName, isActive])
  @@map("approval_processes")
}

model ApprovalStep {
  id             String           @id @default(cuid())
  processId      String
  process        ApprovalProcess  @relation(fields: [processId], references: [id], onDelete: Cascade)
  order          Int
  name           String
  // condition to enter this step; null = always
  entryCondition Json?
  approverSource ApproverSource
  approverConfig Json // depends on source: { userId } | { roleCode } | { levels } | { fieldPath }
  mode           ApprovalStepMode @default(SEQUENTIAL)
  // if rejected at this step: restart, or final rejection
  rejectBehavior String           @default("final_reject") // final_reject | restart | prev_step

  @@unique([processId, order])
  @@map("approval_steps")
}

model ApprovalRequest {
  id                 String                @id @default(cuid())
  tenantId           String
  processId          String
  process            ApprovalProcess       @relation(fields: [processId], references: [id])
  recordType         String
  recordId           String
  submitterId        String
  status             ApprovalRequestStatus @default(PENDING)
  currentStepId      String?
  currentStepOrder   Int?
  // user ids awaiting action at current step (supports PARALLEL_ALL/ANY)
  currentAssigneeIds String[]              @default([])
  submittedAt        DateTime              @default(now())
  finalizedAt        DateTime?
  comments           String?               @db.Text

  actions ApprovalAction[]

  @@index([tenantId, recordType, recordId])
  @@index([tenantId, status])
  @@map("approval_requests")
}

model ApprovalAction {
  id        String             @id @default(cuid())
  requestId String
  request   ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder Int?
  actorId   String
  actor     User               @relation(fields: [actorId], references: [id])
  action    ApprovalActionType
  comment   String?
  metadata  Json               @default("{}")
  createdAt DateTime           @default(now())

  @@index([requestId, createdAt])
  @@map("approval_actions")
}

// ════════════════════════════════════════════════════════════════════════════
// INFRA — audit, outbox, numbering
// ════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String // "create" | "update" | "delete" | "convert" | ...
  recordType String
  recordId   String
  changes    Json     @default("{}") // { field: { from, to } }
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, recordType, recordId])
  @@index([tenantId, actorId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id          String    @id @default(cuid())
  tenantId    String
  eventType   String // "lead.created" | "opportunity.stage_changed" | ...
  recordType  String
  recordId    String
  payload     Json
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
  @@index([tenantId, eventType])
  @@map("outbox_events")
}

model SequenceCounter {
  id       String @id @default(cuid())
  tenantId String
  key      String // e.g. "quote.2026", "order.2026"
  value    Int    @default(0)

  @@unique([tenantId, key])
  @@map("sequence_counters")
}

// ════════════════════════════════════════════════════════════════════════════
// SAVED LIST VIEWS
// ────────────────────────────────────────────────────────────────────────────
// Per-user saved filter+sort presets for any object's list page. Owners can
// also share a view (isShared=true) so the whole tenant sees it.
// ════════════════════════════════════════════════════════════════════════════

model ListView {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // "Lead" | "Opportunity" | "Account" | "Contact" | "<custom>__c"
  objectApiName String
  name          String
  filters       Json     @default("{}")
  sortBy        String?
  sortDir       String?  // "asc" | "desc"
  // Visible to whole tenant when true
  isShared      Boolean  @default(false)
  // The user's default view for this object — at most one per (user, object)
  isDefault     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, objectApiName])
  @@index([tenantId, ownerId, objectApiName])
  @@map("list_views")
}

// ════════════════════════════════════════════════════════════════════════════
// IN-APP NOTIFICATIONS
// ────────────────────────────────────────────────────────────────────────────
// Lightweight per-user inbox. Producers (workflow actions, scheduled jobs,
// approval submission, AI anomaly scan, etc.) write rows; the bell-icon
// dropdown reads them with a periodic poll.
// ════════════════════════════════════════════════════════════════════════════

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model Notification {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  level     NotificationLevel  @default(INFO)
  // Short category like "activity_due" / "approval_pending" / "ai_high_risk"
  kind      String
  title     String
  body      String?            @db.Text
  // Optional CRM target so the UI can deep-link on click
  targetType String?
  targetId   String?

  readAt     DateTime?
  createdAt  DateTime           @default(now())

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

// ════════════════════════════════════════════════════════════════════════════
// AI INSIGHTS
// ────────────────────────────────────────────────────────────────────────────
// Cached LLM-generated insights for any record (opportunity / lead / account /
// account / activity-timeline). Keyed by (tenantId, targetType, targetId, kind)
// so each "kind" of insight (win-prob, score, summary, ...) is a single row
// per record, refreshed on demand or by background workers.
// ════════════════════════════════════════════════════════════════════════════

enum AIInsightKind {
  OPP_WIN_PROBABILITY // {score, riskFactors[], strengths[], nextActions[], summary}
  OPP_NEXT_BEST_ACTION // {actions[]}
  OPP_ACTIVITY_SUMMARY // {summary, sentiment, suggestions[]}
  LEAD_SCORE // {score, fitScore, intentScore, reasoning, qualifiers[], blockers[]}
  LEAD_DRAFT_OUTREACH // {channel, subject, body}
  ACCOUNT_BRIEFING // {summary, latestSignals[], openOpps[], risks[]}
}

model AIInsight {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  targetType String // "opportunity" | "lead" | "account" | ...
  targetId   String
  kind       AIInsightKind

  payload Json // structured result; shape depends on kind
  summary String? @db.Text // short human-readable summary, indexable

  modelName        String // e.g. "claude-sonnet-4-5-20250929"
  promptTokens     Int    @default(0)
  outputTokens     Int    @default(0)
  cacheReadTokens  Int    @default(0)
  cacheWriteTokens Int    @default(0)
  latencyMs        Int    @default(0)

  inputHash     String // hash of inputs used; lets us skip regen when unchanged
  generatedAt   DateTime  @default(now())
  expiresAt     DateTime?
  generatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, targetType, targetId, kind])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, kind, generatedAt])
  @@map("ai_insights")
}

// ════════════════════════════════════════════════════════════════════════════
// HEADLESS CUSTOM OBJECT RECORDS
// ════════════════════════════════════════════════════════════════════════════

model CustomRecord {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objectApiName String // apiName of the ObjectDef
  data          Json    @default("{}")
  ownerId       String?
  owner         User?   @relation("CustomRecordOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, objectApiName])
  @@index([tenantId, ownerId])
  @@map("custom_records")
}

// ── Outbound webhook dead-letter queue ──────────────────────────────────────
// When SendWebhookAction exhausts its retry budget, the request is parked here
// for later inspection/replay by an operator. resolvedAt != null means a human
// (or replay job) has handled it.
model WebhookDeadLetter {
  id             String   @id @default(cuid())
  tenantId       String
  url            String
  method         String   @default("POST")
  headers        Json     @default("{}")
  body           String // raw JSON body that was attempted
  attempts       Int      @default(0)
  lastStatus     Int?
  lastError      String?
  idempotencyKey String
  workflowId     String? // optional: which workflow rule emitted this
  recordType     String?
  recordId       String?
  resolvedAt     DateTime?
  resolvedNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, resolvedAt, createdAt])
  @@index([tenantId, idempotencyKey])
  @@map("webhook_dead_letters")
}

// ════════════════════════════════════════════════════════════════════════════
// CUSTOMER 360 — UNIFIED PERSON GRAPH
// ════════════════════════════════════════════════════════════════════════════
// Person is the canonical individual identity. Lead and Contact both link to
// the same Person when identity rules judge them to be the same human. This
// powers "give me the unified Customer 360 view" queries that span sales
// touchpoints (Lead → Contact), service touchpoints (Case via Contact), and
// marketing touchpoints (CampaignMember via Lead/Contact).
//
// Lead and Contact still own their own lifecycle/pipeline/account fields;
// Person only carries identity-grade data (name, normalized email/phone).

model Person {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Canonical identity values (normalized: lowercase email, digits-only phone)
  primaryEmail      String?
  primaryEmailNorm  String? // lowercase, trimmed — used for fuzzy match
  primaryPhone      String?
  primaryPhoneNorm  String? // digits only — used for fuzzy match
  firstName         String?
  lastName          String?
  fullNameNorm      String? // lowercase concatenated for fuzzy match

  // Free-form identity data (alternate emails/phones, social handles, etc.)
  identifiers Json @default("[]") // [{kind: "email"|"phone"|"linkedin"|..., value, source, verifiedAt}]

  // Counts for fast Customer 360 list views
  leadCount       Int @default(0)
  contactCount    Int @default(0)
  campaignCount   Int @default(0)
  caseCount       Int @default(0)
  opportunityCount Int @default(0)

  // Soft-merge support: when two Persons get merged, the loser's ID points here.
  mergedIntoId String?
  mergedInto   Person?  @relation("PersonMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Person[] @relation("PersonMerge")
  mergedAt     DateTime?

  leads    Lead[]    @relation("LeadPerson")
  contacts Contact[] @relation("ContactPerson")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId, primaryEmailNorm])
  @@index([tenantId, primaryPhoneNorm])
  @@index([tenantId, fullNameNorm])
  @@index([tenantId, mergedIntoId])
  @@map("persons")
}

// Tenant-configurable rules for identity resolution. Evaluated in priority
// order on Lead/Contact write; if any rule matches an existing Person the
// new record links to that Person. If none match a fresh Person is created.
model IdentityRule {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?
  // Comparator: "exact_email" | "exact_phone" | "exact_name_email_domain" |
  //             "fuzzy_name" | "first_letter_lastname_email"
  comparator  String
  // Block on match (don't auto-merge, surface as DedupeCandidate)
  surfaceOnly Boolean @default(false)
  isActive    Boolean @default(true)
  priority    Int     @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, isActive, priority])
  @@map("identity_rules")
}

// When the rule says surfaceOnly=true (or two equally-good matches exist),
// the candidate match is parked here for a human to confirm/reject.
model DedupeCandidate {
  id          String  @id @default(cuid())
  tenantId    String
  // What just got created/updated
  sourceType  String  // "lead" | "contact"
  sourceId    String
  // What it might be a duplicate of
  candidatePersonId String
  ruleId      String? // which rule fired
  score       Float   // 0..1 — confidence
  status      String  @default("pending") // pending | confirmed_merge | rejected
  resolvedAt  DateTime?
  resolvedById String?
  resolvedNote String?
  createdAt   DateTime @default(now())

  @@index([tenantId, status, createdAt])
  @@index([tenantId, sourceType, sourceId])
  @@map("dedupe_candidates")
}

// ════════════════════════════════════════════════════════════════════════════
// INBOUND WEBHOOK ENDPOINTS
// ════════════════════════════════════════════════════════════════════════════
// Tenants register endpoints to which downstream systems POST. Each has a
// unique slug + signingSecret + optional eventType label. Inbound traffic
// hits POST /webhooks/inbound/:slug, gets HMAC-verified, persisted, and
// fanned out to the platform event bus.

model WebhookEndpoint {
  id            String   @id @default(cuid())
  tenantId      String
  slug          String   @unique // path component
  description   String?
  signingSecret String              // shared with caller for HMAC verification
  eventType     String?             // label inserted into the dispatched event name
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  inboundEvents WebhookInboundEvent[]

  @@index([tenantId, isActive])
  @@map("webhook_endpoints")
}

model WebhookInboundEvent {
  id             String          @id @default(cuid())
  tenantId       String
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  idempotencyKey String
  headers        Json            @default("{}")
  body           String          // raw JSON body
  receivedAt     DateTime
  processedAt    DateTime?
  attempts       Int             @default(0)
  lastError      String?
  createdAt      DateTime        @default(now())

  @@unique([tenantId, endpointId, idempotencyKey])
  @@index([tenantId, processedAt, createdAt])
  @@map("webhook_inbound_events")
}

// ════════════════════════════════════════════════════════════════════════════
// RECYCLE BIN — SF-style undelete with 30-day retention (Wave 16b)
// ════════════════════════════════════════════════════════════════════════════

model RecycleBinEntry {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordType  String // "lead" | "account" | "contact" | "opportunity" | "quote" | "order" | "contract" | "activity" | "case"
  recordId    String
  deletedAt   DateTime  @default(now())
  deletedById String?
  // 30 days from deletedAt — column kept for index efficiency
  purgeAfter  DateTime
  // Snapshot for display in the recycle bin UI ("12 件已删除：测试线索 (李明) ...")
  snapshot    Json      @default("{}")
  restoredAt  DateTime?

  @@index([tenantId, restoredAt, purgeAfter])
  @@index([tenantId, recordType])
  @@map("recycle_bin_entries")
}
